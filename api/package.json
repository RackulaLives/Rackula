{
  "name": "@rackula/api",
  "version": "26.9.1",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:worker": "wrangler dev",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "defu": "^6.1.5",
    "postcss": "^8.5.18"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "better-auth": "~1.6.33",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/bun": "^1.4.2",
    "@types/js-yaml": "^4.0.9",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "wrangler": "^4.136.1"
  }
}
