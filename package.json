{
  "name": "rackula",
  "version": "26.8.0",
  "description": "Drag and drop rack visualizer",
  "author": "ggfevans",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RackulaLives/Rackula.git"
  },
  "homepage": "https://github.com/RackulaLives/Rackula",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest",
    "test:run": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:dev": "playwright test --config e2e/playwright.dev.config.ts",
    "test:e2e:smoke": "playwright test --config e2e/playwright.smoke.config.ts",
    "test:e2e:visual": "playwright test --config e2e/playwright.visual.config.ts",
    "test:e2e:visual:update": "playwright test --config e2e/playwright.visual.config.ts --update-snapshots",
    "test:e2e:a11y": "playwright test --config e2e/playwright.a11y.config.ts",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --coverage",
    "check:compose-parity": "bash scripts/check-compose-persist-parity.sh",
    "check:bundle-budget": "npx tsx scripts/check-bundle-budget.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "husky",
    "process-images": "npx tsx scripts/process-images.ts",
    "generate-bundled-images": "npx tsx scripts/generate-bundled-images.ts",
    "generate-brand-assets": "npx tsx scripts/generate-brand-assets.ts",
    "generate-schema": "npx tsx scripts/generate-schema.ts",
    "update-contributors": "npx tsx scripts/update-contributors.ts",
    "refresh-lockfile": "rm -rf node_modules package-lock.json && npm install",
    "deps:status": "npm outdated || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "5.3.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/debug": "^4.1.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.17"
  },
  "lint-staged": {
    "*.{js,ts,svelte,json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0",
    "bits-ui": "^2.19.0",
    "browser-fs-access": "^0.38.0",
    "debug": "^4.4.3",
    "dompurify": "^3.4.14",
    "fuse.js": "^7.5.0",
    "js-yaml": "^4.3.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lz-string": "^1.5.0",
    "marked": "^18.0.11",
    "nanoid": "^6.0.1",
    "pako": "^3.0.1",
    "panzoom": "^9.4.4",
    "qrcode": "^1.5.4",
    "simple-icons": "^16.28.0",
    "svg2pdf.js": "^2.7.0",
    "zod": "^4.4.3"
  }
}
