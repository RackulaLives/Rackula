+  let cullVisible = $state(false);
+  function cullWatch(node: HTMLElement) {
+    const io = new IntersectionObserver(
+      (entries) => {
+        for (const e of entries) cullVisible = e.isIntersecting;
+      },
+      { root: null, rootMargin: "400px" },
+    );
+    io.observe(node);
+    return { destroy: () => io.disconnect() };
+  }
