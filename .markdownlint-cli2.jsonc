// Markdownlint configuration for Rackula documentation
// See: https://github.com/DavidAnson/markdownlint
{
  "config": {
    // Line length: Allow longer lines for tables and code blocks
    // Documentation files benefit from readable tables over strict wrapping
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    }
  },
  // Vendored third-party skills are kept verbatim from their upstream source, so
  // they are not held to this repo's markdown style. Refresh them from upstream.
  "ignores": [".github/claude-plugins/**"]
}
